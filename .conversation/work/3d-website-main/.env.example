NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Add only on the server when Razorpay checkout is wired:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ─── Supabase (wired in Part 2) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay (wired in Part 2) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Google Maps (wired in Part 2) ────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Web Push. Public key is embedded at BUILD time; rebuild after changing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only: never add NEXT_PUBLIC_ to these names.
VAPID_PRIVATE_KEY=
# A real operator contact, e.g. mailto:owner@your-domain.example
VAPID_SUBJECT=
# Random secret, at least 32 characters. Match Supabase Vault's worker secret.
CRON_SECRET=
